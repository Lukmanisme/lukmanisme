# ===================================================
# MIDTRANS CONFIGURATION
# ===================================================
# Dapatkan dari: Midtrans Dashboard -> Settings -> Access Keys
# Sandbox: diawali dengan SB-Mid-server- / SB-Mid-client-
# Production: diawali dengan Mid-server- / Mid-client-
MIDTRANS_SERVER_KEY=SB-Mid-server-your_sandbox_server_key_here
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_sandbox_client_key_here
MIDTRANS_IS_PRODUCTION=false

# ===================================================
# SUPABASE CONFIGURATION
# ===================================================
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://vojacwqruwkhcswyqhyh.supabase.co
# Wajib gunakan service_role key (secret) agar webhook dapat mengupdate
# tabel subscriptions & payment_requests tanpa terblokir RLS.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===================================================
# PUBLIC APP URL
# ===================================================
APP_URL=https://lukmanisme.vercel.app

# ===================================================
# PAYMENT GATEWAY SELECTOR (midtrans / xoftware)
# ===================================================
# Default fallback adalah 'midtrans'. Set ke 'xoftware' untuk beralih ke Xoftware Pay.
PAYMENT_GATEWAY=midtrans

# ===================================================
# XOFTWARE PAY CONFIGURATION (PLAN B)
# ===================================================
# Dapatkan dari: https://pay.xoftware.id/ -> Dashboard -> Integration / API Keys
XOFTWARE_MERCHANT_ID=101
XOFTWARE_API_KEY=your_xoftware_api_key_here
XOFTWARE_WEBHOOK_SECRET=your_xoftware_webhook_secret_here
# Mode: true untuk production, false untuk sandbox/staging
XOFTWARE_IS_PRODUCTION=true
